#!/bin/bash
# Which Claude account applies here, and why.
# Locate resolve.sh: an explicit override, then next to this script (installed
# layout: bin/../libexec), then the per-user config dir. Keeps a from-source run,
# a Homebrew install and an npm install all working from one file.
_ca_self="${BASH_SOURCE[0]:-$0}"
# Follow symlinks FIRST. Homebrew links /opt/homebrew/bin/claude-account -> ../Cellar/…/bin/,
# and npm links into node_modules; dirname of the LINK is a directory with no libexec beside
# it, so every candidate below missed and the lookup fell through to ~/.config — a file only
# a source install creates. MEASURED: the brew build was running the ~/.config resolver.
while [ -L "$_ca_self" ]; do
  _t="$(readlink "$_ca_self")"
  case "$_t" in /*) _ca_self="$_t" ;; *) _ca_self="$(dirname "$_ca_self")/$_t" ;; esac
done
_ca_dir="$(cd "$(dirname "$_ca_self")" 2>/dev/null && pwd)"
for _c in "${CLAUDE_ACCOUNTS_LIB:-}/resolve.sh" \
          "$_ca_dir/../libexec/resolve.sh" \
          "$_ca_dir/../lib/claude-account/resolve.sh" \
          "$HOME/.config/claude-accounts/resolve.sh"; do
  [ -n "$_c" ] && [ -f "$_c" ] && { RESOLVE="$_c"; break; }
done
RESOLVE="${RESOLVE:-$HOME/.config/claude-accounts/resolve.sh}"
[ -n "${CLAUDE_ACCOUNTS_LIB:-}" ] && [ ! -f "${CLAUDE_ACCOUNTS_LIB}/resolve.sh" ] \
  && printf 'claude: CLAUDE_ACCOUNTS_LIB=%s has no resolve.sh — using %s\n' "$CLAUDE_ACCOUNTS_LIB" "$RESOLVE" >&2
MAP="${CLAUDE_ACCOUNTS_MAP:-$HOME/.config/claude-accounts/paths.map}"
PORC=0
case "${1:-}" in -q|--porcelain) PORC=1; shift ;; esac
dir=${1:-$PWD}
# Same global token and colour the CLI uses, so the two never disagree about what
# "global" looks like. Colour only to a terminal, and never when NO_COLOR is set.
CA_GTAG="(global)"
if [ -z "${NO_COLOR:-}" ] && [ -t 1 ]; then GT=$'\033[36m'"$CA_GTAG"$'\033[0m'; else GT="$CA_GTAG"; fi
line=$([ -x "$RESOLVE" ] && "$RESOLVE" "$dir" 2>/dev/null)
# --porcelain: exactly one ANSI-free line for scripts:  <account>\t<source>\t<signed_in>
# source ∈ env-override|token-override|rule|worktree|fallback|none ; signed_in ∈ yes|no|error|-
if [ "$PORC" = 1 ]; then
  if [ -n "$CLAUDE_SECURESTORAGE_CONFIG_DIR" ]; then
    printf '%s\tenv-override\t-\n' "$(basename "$CLAUDE_SECURESTORAGE_CONFIG_DIR")"; exit 0
  fi
  if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then printf '(token)\ttoken-override\t-\n'; exit 0; fi
  if [ -z "$line" ]; then printf '(global)\tnone\t-\n'; exit 0; fi
  pn=$(printf '%s' "$line" | cut -f1); pd=$(printf '%s' "$line" | cut -f2); pr=$(printf '%s' "$line" | cut -f3)
  src=rule; case "$pr" in "(fallback)") src=fallback ;; *" (worktree)") src=worktree ;; esac
  security find-generic-password -s "Claude Code-credentials-$(printf '%s' "$pd" | shasum -a 256 | cut -c1-8)" >/dev/null 2>&1
  case $? in 0) si=yes ;; 44) si=no ;; *) si=error ;; esac
  printf '%s\t%s\t%s\n' "$pn" "$src" "$si"; exit 0
fi
echo "directory     : $dir"
if [ -n "$CLAUDE_SECURESTORAGE_CONFIG_DIR" ]; then
  echo "account       : (explicit override in env)"
  echo "profile dir   : $CLAUDE_SECURESTORAGE_CONFIG_DIR"
elif [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
  echo "account       : (explicit OAuth token override in env — CLAUDE_CODE_OAUTH_TOKEN)"
  echo "                the token wins over every rule; routing is bypassed for this shell"
elif [ -z "$line" ]; then
  # resolve.sh skips a PAUSED rule, so a bare "none" is a half-truth: there IS a rule here,
  # it is simply not routing. Saying "none" sends you looking for a rule you already have.
  # Same class of half-truth as the list/profiles wording bugs — report what is really there.
  parked=$(awk -F'\t' -v d="$dir/" '
    $1 ~ /^#/ || NF < 2 { next }
    { p=$1; sub(/\/$/, "", p)
      if (index(d, p "/") == 1 && length(p) > L) { L=length(p); P=p; N=$2; W=($4=="global" ? "switched to global" : "paused") } }
    END { if (N) printf "%s\t%s\t%s\n", P, N, W }' "$MAP" 2>/dev/null)
  if [ -n "$parked" ]; then
    echo "matched rule  : $(printf '%s' "$parked" | cut -f1)"
    echo "                ...but it is $(printf '%s' "$parked" | cut -f3), so it is NOT routing"
    echo "account       : $GT — resume JUST this path with:  claude-account resume '$(printf '%s' "$parked" | cut -f1)'"
  else
    echo "matched rule  : none"
    echo "account       : $GT — whatever you signed in with (VS Code \"Switch account\")"
  fi
elif [ "$(printf '%s' "$line" | cut -f3)" = "(fallback)" ]; then
  # No rule matched — the machine-wide fallback applies. Never print "(fallback)" as if
  # it were a matched rule: no rule matched, and saying otherwise sends you hunting for
  # a rule that does not exist.
  name=$(printf '%s' "$line" | cut -f1); pdir=$(printf '%s' "$line" | cut -f2)
  parked=$(awk -F'\t' -v d="$dir/" '
    $1 ~ /^#/ || NF < 2 { next }
    { p=$1; sub(/\/$/, "", p)
      if (index(d, p "/") == 1 && length(p) > L) { L=length(p); P=p; N=$2 } }
    END { if (N) printf "%s\t%s\n", P, N }' "$MAP" 2>/dev/null)
  if [ -n "$parked" ]; then
    echo "matched rule  : $(printf '%s' "$parked" | cut -f1)"
    echo "                ...but it is paused, so it is NOT routing"
    echo "account       : $name — via the machine FALLBACK (resume JUST this path: claude-account resume '$(printf '%s' "$parked" | cut -f1)')"
  else
    echo "matched rule  : none — the machine FALLBACK applies"
    echo "account       : $name  (back to global: claude-account use global)"
  fi
  echo "profile dir   : $pdir"
  svc="Claude Code-credentials-$(printf '%s' "$pdir" | shasum -a 256 | cut -c1-8)"
  security find-generic-password -s "$svc" >/dev/null 2>&1; _fsrc=$?
  if [ "$_fsrc" -eq 0 ]; then
    echo "login         : signed in"
  elif [ "$_fsrc" -ne 44 ]; then
    echo "login         : could not verify (security exit $_fsrc) — the shim routes to it anyway"
  else
    echo "login         : NOT signed in — this folder falls back to $GT"
    echo "                run:  claude-account login $name   (or: claude-account use global)"
  fi
else
  name=$(printf '%s' "$line" | cut -f1); pdir=$(printf '%s' "$line" | cut -f2); pre=$(printf '%s' "$line" | cut -f3)
  echo "matched rule  : $pre"
  echo "account       : $name"
  echo "profile dir   : $pdir"
  # The SAME live Keychain check the shim makes at launch, so this reports what will
  # actually happen rather than only which rule matched. Printing "account: every"
  # when 'every' has no credential is a lie: that session falls back to global and
  # spends the wrong plan. (--probe, which this used to recommend, no longer exists.)
  # This check is duplicated in claude-shim and claude-vscode-wrapper — keep the three
  # in step, or lift it into resolve.sh.
  svc="Claude Code-credentials-$(printf '%s' "$pdir" | shasum -a 256 | cut -c1-8)"
  security find-generic-password -s "$svc" >/dev/null 2>&1; _src=$?
  if [ "$_src" -eq 0 ]; then
    echo "login         : signed in"
  elif [ "$_src" -ne 44 ]; then
    echo "login         : could not verify (security exit $_src) — the shim routes to it anyway"
  else
    echo "login         : NOT signed in — this folder falls back to $GT"
    echo "                run:  claude-account login $name   (or: claude-account pause $name)"
  fi
fi
echo "shared        : plugins, MCP servers, memory, settings, hooks, history (from ~/.claude)"
echo "terminal claude resolves to: $(command -v claude)"
