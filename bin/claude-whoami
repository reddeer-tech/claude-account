#!/bin/bash
# Which Claude account applies here, and why.
# Locate resolve.sh: an explicit override, then next to this script (installed
# layout: bin/../libexec), then the per-user config dir. Keeps a from-source run,
# a Homebrew install and an npm install all working from one file.
_ca_self="${BASH_SOURCE[0]:-$0}"
_ca_dir="$(cd "$(dirname "$_ca_self")" 2>/dev/null && pwd)"
for _c in "${CLAUDE_ACCOUNTS_LIB:-}/resolve.sh" \
          "$_ca_dir/../libexec/resolve.sh" \
          "$_ca_dir/../lib/claude-account/resolve.sh" \
          "$HOME/.config/claude-accounts/resolve.sh"; do
  [ -n "$_c" ] && [ -f "$_c" ] && { RESOLVE="$_c"; break; }
done
RESOLVE="${RESOLVE:-$HOME/.config/claude-accounts/resolve.sh}"
MAP="${CLAUDE_ACCOUNTS_MAP:-$HOME/.config/claude-accounts/paths.map}"
dir=${1:-$PWD}
echo "directory     : $dir"
line=$([ -x "$RESOLVE" ] && "$RESOLVE" "$dir" 2>/dev/null)
if [ -n "$CLAUDE_SECURESTORAGE_CONFIG_DIR" ]; then
  echo "account       : (explicit override in env)"
  echo "profile dir   : $CLAUDE_SECURESTORAGE_CONFIG_DIR"
elif [ -z "$line" ]; then
  echo "matched rule  : none"
  echo "account       : GLOBAL — whatever you signed in with (VS Code \"Switch account\")"
else
  name=$(printf '%s' "$line" | cut -f1); pdir=$(printf '%s' "$line" | cut -f2); pre=$(printf '%s' "$line" | cut -f3)
  echo "matched rule  : $pre"
  echo "account       : $name"
  echo "profile dir   : $pdir"
  # The SAME live Keychain check the shim makes at launch, so this reports what will
  # actually happen rather than only which rule matched. Printing "account: every"
  # when 'every' has no credential is a lie: that session falls back to global and
  # spends the wrong plan. (--probe, which this used to recommend, no longer exists.)
  # This check is duplicated in claude-shim and claude-vscode-wrapper — keep the three
  # in step, or lift it into resolve.sh.
  svc="Claude Code-credentials-$(printf '%s' "$pdir" | shasum -a 256 | cut -c1-8)"
  if security find-generic-password -s "$svc" >/dev/null 2>&1; then
    echo "login         : signed in"
  else
    echo "login         : NOT signed in — this folder falls back to your GLOBAL account"
    echo "                run:  claude-account login $name   (or: claude-account pause $name)"
  fi
fi
echo "shared        : plugins, MCP servers, memory, settings, hooks, history (from ~/.claude)"
echo "terminal claude resolves to: $(command -v claude)"
